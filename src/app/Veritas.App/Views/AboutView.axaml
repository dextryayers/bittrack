<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Veritas.App.ViewModels"
             x:Class="Veritas.App.Views.AboutView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Margin="46,38,46,46" MaxWidth="760" HorizontalAlignment="Center">
            <TextBlock Text="TENTANG" Classes="eyebrow" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" Margin="0,14,0,0">
                <Border Width="64" Height="64" BorderBrush="{DynamicResource InkBrush}" BorderThickness="1"
                        CornerRadius="1">
                    <TextBlock Text="V" FontSize="36" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Veritas" Classes="h1" />
                    <TextBlock Text="MEJA VERIFIKASI FAKTA · V1.0-ALPHA" Classes="meta" />
                </StackPanel>
            </Grid>

            <Border Classes="accentRule" Margin="0,22,0,0" />

            <TextBlock Classes="prose" FontSize="15" LineHeight="25" Margin="0,24,0,0"
                       Text="Veritas adalah alat bantu pemeriksaan klaim untuk bahasa Indonesia. Teks, tautan, poster, dan komentar diproses di perangkat. Model bahasa lokal menilai klaim inti dengan bantuan bukti dari sumber yang dapat diperiksa, lalu engine membatasi verdict ketika dukungan bukti tipis." />

            <Border Classes="rule" Margin="0,30,0,22" />
            <TextBlock Text="APA YANG DIKERJAKAN" Classes="eyebrow" />
            <StackPanel Spacing="10" Margin="0,12,0,0">
                <TextBlock Classes="prose" Text="· Mengambil isi artikel dari tautan dan mengekstrak teks utama." />
                <TextBlock Classes="prose" Text="· Mencari bukti di cek fakta, ensiklopedia, dan kanal berita tepercaya." />
                <TextBlock Classes="prose" Text="· Menjalankan model GGUF lokal melalui llama.cpp tanpa backend." />
                <TextBlock Classes="prose" Text="· Memecah klaim, menautkan nomor bukti, dan menampilkan catatan ketidakpastian." />
                <TextBlock Classes="prose" Text="· Menyimpan hasil lengkap secara lokal agar dapat dibuka kembali." />
            </StackPanel>

            <Border Classes="rule" Margin="0,28,0,22" />
            <TextBlock Text="YANG TIDAK DIKLAIM" Classes="eyebrow" />
            <StackPanel Spacing="10" Margin="0,12,0,0">
                <TextBlock Classes="prose" Text="· Akurasi tidak dijamin. Model 3B dapat salah, terutama pada konteks lokal yang tidak tercakup bukti." />
                <TextBlock Classes="prose" Text="· Skor kebenaran dan skor tulisan AI adalah keluaran model yang belum dikalibrasi; bukan probabilitas tervalidasi." />
                <TextBlock Classes="prose" Text="· Sinyal domain, buzzer, dan clickbait tidak pernah menghasilkan verdict." />
                <TextBlock Classes="prose" Text="· Hasil bukan dasar hukum, keputusan editorial, atau bukti final." />
                <TextBlock Classes="prose" Text="· Tidak ada telemetri, akun, cloud model, atau fallback kata kunci yang menyamar sebagai analisis." />
            </StackPanel>

            <Border Classes="rule" Margin="0,28,0,22" />
            <TextBlock Text="ARSITEKTUR" Classes="eyebrow" />
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,12,0,0">
                <TextBlock Text="Antarmuka" Classes="meta" Margin="0,0,0,7" />
                <TextBlock Grid.Column="1" Text="C# · Avalonia 12 · MVVM" Classes="mono" Margin="0,0,0,7" />
                <TextBlock Grid.Row="1" Text="Engine" Classes="meta" Margin="0,0,0,7" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Rust · C ABI · in-process" Classes="mono" Margin="0,0,0,7" />
                <TextBlock Grid.Row="2" Text="Inferensi" Classes="meta" Margin="0,0,0,7" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="llama.cpp · GGUF lokal · CPU" Classes="mono" Margin="0,0,0,7" />
                <TextBlock Grid.Row="3" Text="Bukti" Classes="meta" Margin="0,0,0,7" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Bing HTML · Wikipedia ID" Classes="mono" Margin="0,0,0,7" />
                <TextBlock Grid.Row="4" Text="OCR" Classes="meta" Margin="0,0,0,7" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Windows.Media.Ocr · on-device" Classes="mono" Margin="0,0,0,7" />
                <TextBlock Grid.Row="5" Text="Prompt" Classes="meta" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="veritas-id-v3" Classes="mono" />
            </Grid>

            <Border Classes="rule" Margin="0,28,0,22" />
            <TextBlock Text="LISENSI" Classes="eyebrow" />
            <TextBlock Classes="prose muted" Margin="0,10,0,0"
                       Text="Kode Veritas dilisensikan MIT OR Apache-2.0. Lisensi model GGUF yang Anda unggah berlaku terpisah; periksa lisensi model tersebut sebelum digunakan atau didistribusikan." />

            <Border Classes="rule" Margin="0,30,0,16" />
            <TextBlock Text="Dibuat untuk pemeriksaan manusia, bukan pengganti pertimbangan manusia." Classes="faint" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
