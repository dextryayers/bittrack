<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Veritas.App.ViewModels"
             xmlns:svc="using:Veritas.Core.Services"
             xmlns:conv="using:Veritas.App.Converters"
             x:Class="Veritas.App.Views.HomeView"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <conv:VerdictToBrushConverter x:Key="VerdictBrush" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="48,42,48,40" MaxWidth="1040" HorizontalAlignment="Center">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="MEJA VERIFIKASI FAKTA" Classes="eyebrow" />
                <TextBlock Grid.Column="1" Text="V1.0-ALPHA · LOKAL" Classes="meta" />
            </Grid>
            <Border Classes="accentRule" Margin="0,12,0,0" />

            <Grid ColumnDefinitions="1.55*,1*" Margin="0,30,0,0">
                <StackPanel Spacing="20" Margin="0,0,54,0">
                    <TextBlock Classes="display" Text="Periksa klaim sebelum ikut menyebarkan." />
                    <TextBlock Classes="lede" MaxWidth="600"
                               Text="Veritas membaca teks, tautan, poster, atau komentar, mencari bukti dari sumber tepercaya, lalu meminta model bahasa lokal menimbang klaim inti. Model berjalan di perangkat ini." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Mulai analisis" Classes="primary" Command="{Binding OpenAnalyzeCommand}" />
                        <Button Content="Analisis poster" Command="{Binding OpenPosterCommand}" />
                    </StackPanel>

                    <Border Classes="notice" IsVisible="{Binding !HasUsableModel}" Margin="0,6,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="MODEL BELUM SIAP" Classes="eyebrow" Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Classes="prose"
                                       Text="Tanpa model GGUF yang berhasil dimuat, engine menolak memberi verdict. Unggah model lokal terlebih dahulu; tidak ada fallback kata kunci yang berpura-pura menjadi analisis." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Unggah model .gguf" Classes="primary" Command="{Binding UploadModelCommand}" />
                                <Button Content="Buka pengaturan" Classes="quiet" Command="{Binding OpenSettingsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="0">
                    <TextBlock Text="CARA KERJA" Classes="eyebrow" Margin="0,0,0,10" />
                    <Border Classes="rule" />
                    <Grid ColumnDefinitions="34,*" Margin="0,12,0,0">
                        <TextBlock Text="01" Classes="meta" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Masukan" Classes="h3" />
                            <TextBlock Classes="prose muted" Text="Teks berita, tautan, hasil OCR poster, atau rangkaian komentar." />
                        </StackPanel>
                    </Grid>
                    <Border Classes="rule" Margin="0,12,0,0" />
                    <Grid ColumnDefinitions="34,*" Margin="0,12,0,0">
                        <TextBlock Text="02" Classes="meta" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Bukti" Classes="h3" />
                            <TextBlock Classes="prose muted" Text="Pencarian dibatasi ke cek fakta, ensiklopedia, dan kanal berita yang dikenal." />
                        </StackPanel>
                    </Grid>
                    <Border Classes="rule" Margin="0,12,0,0" />
                    <Grid ColumnDefinitions="34,*" Margin="0,12,0,0">
                        <TextBlock Text="03" Classes="meta" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Pertimbangan model" Classes="h3" />
                            <TextBlock Classes="prose muted" Text="Model lokal menilai klaim, memecahnya, dan menandai bagian yang meragukan." />
                        </StackPanel>
                    </Grid>
                    <Border Classes="rule" Margin="0,12,0,0" />
                    <Grid ColumnDefinitions="34,*" Margin="0,12,0,0">
                        <TextBlock Text="04" Classes="meta" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Keputusan Anda" Classes="h3" />
                            <TextBlock Classes="prose muted" Text="Hasil adalah bahan pemeriksaan, bukan putusan akhir. Buka buktinya." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Classes="rule" Margin="0,42,0,26" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock Text="RIWAYAT TERBARU" Classes="eyebrow" />
                <Button Grid.Column="1" Content="Lihat semua" Classes="link" Command="{Binding NavigateCommand}"
                        CommandParameter="3" />
            </Grid>

            <ItemsControl ItemsSource="{Binding RecentHistory}" IsVisible="{Binding HasRecentHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:HistoryEntry">
                        <StackPanel>
                            <Button Classes="quiet" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" Padding="0,12"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenHistoryCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="136,128,*,Auto">
                                    <TextBlock Text="{Binding CreatedAtDisplay}" Classes="meta" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding VerdictDisplay}"
                                               Foreground="{Binding Verdict, Converter={StaticResource VerdictBrush}}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding InputPreview}" Classes="prose"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding ConfidenceDisplay}" Classes="mono"
                                               VerticalAlignment="Center" Margin="16,0,0,0" />
                                </Grid>
                            </Button>
                            <Border Classes="rule" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="soft" IsVisible="{Binding !HasRecentHistory}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Belum ada analisis tersimpan." Classes="h3" />
                    <TextBlock Classes="prose muted"
                               Text="Hasil pertama akan muncul di sini beserta verdict dan ringkasannya." />
                </StackPanel>
            </Border>

            <Border Classes="rule" Margin="0,38,0,24" />

            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="48">
                <StackPanel Spacing="8">
                    <TextBlock Text="CATATAN METODE" Classes="eyebrow" />
                    <TextBlock Classes="prose muted"
                               Text="Verdict dihasilkan model GGUF lokal melalui llama.cpp. Engine memeriksa apakah klaim merujuk bukti, membatasi keyakinan saat bukti tipis, dan menurunkan verdict tegas menjadi tidak terverifikasi bila tidak ada dukungan. Heuristik domain, buzzer, dan clickbait hanya ditampilkan sebagai konteks." />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="BATAS YANG HARUS DIKETAHUI" Classes="eyebrow" />
                    <TextBlock Classes="prose muted"
                               Text="Skor kebenaran dan skor tulisan AI adalah keluaran model yang belum dikalibrasi terhadap benchmark publik; jangan memperlakukannya sebagai probabilitas tervalidasi. Model kecil dapat salah, terutama pada konteks lokal yang tidak tercakup bukti. Verifikasi manual tetap diperlukan." />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
