<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Veritas.App.ViewModels"
             x:Class="Veritas.App.Views.HomeView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="0" MaxWidth="980" HorizontalAlignment="Center">
        <Border CornerRadius="22" Padding="28" Margin="0,0,0,24" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#0B1526" Offset="0" />
                    <GradientStop Color="#182741" Offset="0.55" />
                    <GradientStop Color="#3A1220" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="56" Height="56" CornerRadius="16" Background="#22FFFFFF" Padding="6">
                            <Image Source="/Assets/logo.png" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Veritas" FontSize="30" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Analisis hoaks dengan model GGUF lokal" Foreground="#A9B7CF" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Tempel teks berita, tautan, atau komentar. Model AI lokal menganalisis klaim, mencari bukti dari sumber tepercaya, lalu memberi verdict, ringkasan, dan persentase kebenaran."
                               Foreground="#C7D2E5" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#1FFFFFFF" CornerRadius="999" Padding="10,4">
                            <TextBlock Text="Model lokal" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#1FFFFFFF" CornerRadius="999" Padding="10,4">
                            <TextBlock Text="Bukti nyata" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#1FFFFFFF" CornerRadius="999" Padding="10,4">
                            <TextBlock Text="Tanpa simulasi" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="92" Height="92" CornerRadius="46" Background="#14FFFFFF"
                        VerticalAlignment="Center" Margin="24,0,0,0">
                    <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"
                          Fill="#FF5A66" Stretch="Uniform" Width="44" Height="44" />
                </Border>
            </Grid>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Tautan berita" Classes="label" />
                    <TextBox Text="{Binding InputUrl}" PlaceholderText="https://contoh.com/berita/..." />
                    <TextBlock Text="Isi artikel diambil langsung dari tautan. Jika pengambilan gagal, tempel teksnya di bawah."
                               Classes="muted" FontSize="11" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Teks berita" Classes="label" />
                    <TextBox Text="{Binding InputText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="160"
                             PlaceholderText="Paste teks berita atau artikel di sini..." />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Komentar pembaca (opsional)" Classes="label" />
                    <TextBox Text="{Binding InputComments}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="72"
                             PlaceholderText="Tempel komentar untuk membantu model mengenali pola buzzer..." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Analisis sekarang" Classes="primary" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Bersihkan" Classes="ghost" Command="{Binding ClearCommand}" />
                    <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="False" Minimum="0" Maximum="100"
                                 Value="{Binding AnalysisProgress}" Width="200" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Margin="0,24,0,8" Spacing="12">
            <TextBlock Text="Cara kerja" Classes="h2" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="cardAlt lift">
                    <StackPanel Spacing="6">
                        <TextBlock Text="01" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Ambil masukan" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Teks, tautan artikel, komentar, atau teks poster hasil OCR." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="cardAlt lift">
                    <StackPanel Spacing="6">
                        <TextBlock Text="02" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Cari bukti" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Cek fakta dan ensiklopedia tepercaya diambil langsung dari internet." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="cardAlt lift">
                    <StackPanel Spacing="6">
                        <TextBlock Text="03" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Inferensi GGUF" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Qwen 2.5 berjalan di perangkat ini dengan keluaran JSON terbatas skema." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="cardAlt lift">
                    <StackPanel Spacing="6">
                        <TextBlock Text="04" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Hasil jujur" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Verdict, keyakinan, persentase kebenaran, klaim, dan peringatan." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
