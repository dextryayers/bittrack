                <StackPanel Grid.Row="2" Spacing="4" Margin="4,16,0,4">
                    <TextBlock Text="Offline. Tanpa backend." FontSize="10" Classes="muted" />
                    <TextBlock Text="MIT OR Apache-2.0" FontSize="10" Classes="muted" />
