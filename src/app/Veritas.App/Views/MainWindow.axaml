<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Veritas.App.ViewModels"
        xmlns:views="using:Veritas.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
        x:Class="Veritas.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.png"
        Title="Veritas - Hoax &amp; Buzzer Detector"
        Width="1100" Height="780"
        MinWidth="900" MinHeight="640">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="260,*">
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="18">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="4,8,0,24">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource CardBrush}" Padding="4">
                        <Image Source="/Assets/logo.png" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Veritas" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="V1.0-Alpha" FontSize="10" Classes="muted" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex}" SelectionMode="Single">
                    <ListBoxItem Classes="nav" Content="Beranda" />
                    <ListBoxItem Classes="nav" Content="Analisis" />
                    <ListBoxItem Classes="nav" Content="Riwayat" />
                    <ListBoxItem Classes="nav" Content="Pengaturan" />
                    <ListBoxItem Classes="nav" Content="Tentang" />
                </ListBox>

                <StackPanel Grid.Row="2" Spacing="4" Margin="4,16,0,4">
                    <TextBlock Text="Offline. Tanpa backend." FontSize="10" Classes="muted" />
                    <TextBlock Text="MIT OR Apache-2.0" FontSize="10" Classes="muted" />
                </StackPanel>
            </Grid>
        </Border>

        <Carousel Grid.Column="1" SelectedIndex="{Binding SelectedPageIndex}">
            <Carousel.PageTransition>
                <CrossFade Duration="0:0:0.35" />
            </Carousel.PageTransition>
            <views:HomeView />
            <views:AnalyzeView />
            <views:HistoryView />
            <views:SettingsView />
            <views:AboutView />
        </Carousel>
    </Grid>
</Window>
