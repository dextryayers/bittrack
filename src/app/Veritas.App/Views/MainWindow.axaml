<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Veritas.App.ViewModels"
        xmlns:views="using:Veritas.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
        x:Class="Veritas.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.png"
        Title="Veritas — Meja Verifikasi Fakta"
        Width="1120" Height="780"
        MinWidth="900" MinHeight="640">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="0" />
        <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="4" />
        <KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateCommand}" CommandParameter="5" />
        <KeyBinding Gesture="Ctrl+7" Command="{Binding NavigateCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding AnalyzeCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding UploadModelCommand}" />
    </Window.KeyBindings>

    <Grid ColumnDefinitions="238,*">
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="20,24,20,18">

                <StackPanel Grid.Row="0" Spacing="18" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="38" Height="38" BorderBrush="{DynamicResource InkBrush}"
                                BorderThickness="1" CornerRadius="1">
                            <TextBlock Text="V" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="VERITAS" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="MEJA VERIFIKASI" Classes="meta" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex}" SelectionMode="Single" VerticalAlignment="Top">
                    <ListBoxItem Classes="nav" AutomationProperties.Name="Beranda">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Text="01" Classes="meta" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Beranda" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Classes="nav" AutomationProperties.Name="Analisis">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Text="02" Classes="meta" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Analisis" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Classes="nav" AutomationProperties.Name="Poster">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Text="03" Classes="meta" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Poster" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Classes="nav" AutomationProperties.Name="Riwayat">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Text="04" Classes="meta" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Riwayat" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Classes="nav" AutomationProperties.Name="Pengaturan">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Text="05" Classes="meta" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Pengaturan" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Classes="nav" AutomationProperties.Name="Tentang">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Text="06" Classes="meta" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Tentang" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Classes="nav" AutomationProperties.Name="Deteksi AI">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Text="07" Classes="meta" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Deteksi AI" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Row="2" Spacing="10">
                    <Border Classes="rule" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="MODEL AKTIF" Classes="eyebrow" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" IsVisible="{Binding HasUsableModel}" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}"
                                     VerticalAlignment="Center" IsVisible="{Binding !HasUsableModel}" />
                            <TextBlock Text="{Binding SelectedModel.Name, TargetNullValue='Belum ada model'}"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModelLoadStatus}" Classes="faint" TextWrapping="Wrap" />
                    </StackPanel>
                    <ProgressBar IsVisible="{Binding IsModelLoading}" IsIndeterminate="True" />
                    <Button Content="Kelola model" Classes="quiet" Command="{Binding OpenSettingsCommand}"
                            HorizontalAlignment="Left" Padding="0,4" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <Carousel Grid.Row="0" SelectedIndex="{Binding SelectedPageIndex}">
                <Carousel.PageTransition>
                    <CrossFade Duration="0:0:0.16" />
                </Carousel.PageTransition>
                <views:HomeView />
                <views:AnalyzeView />
                <views:PosterView />
                <views:HistoryView />
                <views:SettingsView />
                <views:AboutView />
                <views:AiDetectView />
            </Carousel>

            <Border Grid.Row="1" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0"
                    Padding="22,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Status}" Classes="faint" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="LOKAL · TANPA TELEMETRI · v1.0.0-ALPHA" Classes="meta"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
